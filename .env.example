# ============================================================
# EchoLabs environment
# Copy to .env and fill in. Empty values fall back to the
# clearly-marked placeholder paths described below.
# ============================================================

# Express tool-gateway port
PORT=4000

# --- Database (MongoDB) --------------------------------------
# REQUIRED for real persistence. Paste a mongodb+srv://... Atlas URI.
# While this is empty the backend runs a clearly-marked IN-MEMORY
# placeholder store seeded at startup (demo mode, no persistence).
MONGODB_URI=

# --- Speech-to-Text (AssemblyAI) ------------------------------
# Paste an AssemblyAI API key to enable transcription.
# While empty, the voice endpoint accepts a `text` field instead of
# audio (marked DEMO fallback) and reports stt:false.
ASSEMBLYAI_API_KEY=

# --- Text-to-Speech (ElevenLabs) -------------------------------
# Paste an ElevenLabs API key to enable spoken replies.
# Voice/model overridable; defaults below.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Conversation brain (LLM, OpenAI-compatible) ---------------
# Paste an OpenAI API key for the real function-calling brain.
# While empty, the server runs a clearly-marked rule-based
# PLACEHOLDER brain over the SAME tool-use loop code path so the
# demo and tests exercise the real loop.
# Also usable with Ollama etc. via OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Misc -------------------------------------------------------
# Currency symbol the LLM uses in spoken totals.
CURRENCY=
# Origin the agent loop uses to reach the tool gateway over HTTP.
SELF_ORIGIN=