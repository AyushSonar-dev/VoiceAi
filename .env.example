# ============================================================
# EchoLabs environment
# Copy to .env and fill in. Empty values fall back to the
# clearly-marked placeholder paths described below.
# ============================================================

# Express tool-gateway port
PORT=4000

# --- Database (MongoDB) --------------------------------------
# REQUIRED for real persistence. Paste a mongodb+srv://... Atlas URI.
# While this is empty the backend runs a clearly-marked IN-MEMORY
# placeholder store seeded at startup (demo mode, no persistence).
#
# If this is set but the database is UNREACHABLE (bad URI, no network,
# IP not in the Atlas allowlist) the backend logs a loud warning and
# still starts on the in-memory store, so the website keeps working.
# Set REQUIRE_MONGO=true to make an unreachable database fatal instead
# (recommended when deploying, where silently losing writes is worse
# than not starting).
MONGODB_URI=
REQUIRE_MONGO=false

# --- Speech-to-Text (AssemblyAI) ------------------------------
# Paste an AssemblyAI API key to enable transcription.
# While empty, the voice endpoint accepts a `text` field instead of
# audio (marked DEMO fallback) and reports stt:false.
ASSEMBLYAI_API_KEY=

# --- Text-to-Speech (ElevenLabs) -------------------------------
# Paste an ElevenLabs API key to enable spoken replies.
# Voice/model overridable; defaults below.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice settings for natural, human-like speech (multilingual v2 supports bilingual)
# stability: 0.0-1.0 (lower = more expressive/emotional variation)
# similarity_boost: 0.0-1.0 (higher = closer to original voice)
# style: 0.0-1.0 (higher = more expressive style exaggeration)
# use_speaker_boost: true/false (enhances similarity)
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY_BOOST=0.85
ELEVENLABS_STYLE=0.6
ELEVENLABS_USE_SPEAKER_BOOST=true

# --- Conversation brain (text/demo path) -------------------------
# Gemini, reached through Google's OpenAI-compatible endpoint. Optional:
# without a key the rule-based placeholder brain runs over the same tool
# loop. The live voice path uses AssemblyAI's own LLM and needs no key here.
# Get a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Misc -------------------------------------------------------
# Currency symbol the LLM uses in spoken totals.
CURRENCY=
# Origin the agent loop uses to reach the tool gateway over HTTP.
SELF_ORIGIN=

# ============================================================
# DEPLOYMENT ON VERCEL (frontend) + RAILWAY/RENDER (backend)
# ============================================================
#
# 1. Push the repo to GitHub.
#
# 2. Deploy the BACKEND to Railway or Render:
#    - Point it at this repo's root
#    - Set "Root Directory" = backend (or use the backend/Dockerfile)
#    - Add all the env vars from this file to Railway/Render
#    - Note the deployed URL, e.g. https://echomart-backend.up.railway.app
#
# 3. Deploy the FRONTEND to Vercel:
#    - Import the repo on vercel.com
#    - Set "Root Directory" = frontend
#    - Add ONE environment variable:
#        BACKEND_ORIGIN = https://echomart-backend.up.railway.app
#    - Deploy. Vercel's rewrites proxy /api/* to your Railway backend.
#
# The CORS origin check on the backend must also be updated to allow
# your *.vercel.app domain in production.
