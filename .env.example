# ============================================================
# EchoLabs environment
# Copy to .env and fill in. Empty values fall back to the
# clearly-marked placeholder paths described below.
# ============================================================

# Express tool-gateway port
PORT=4000

# --- Database (MongoDB) --------------------------------------
# REQUIRED for real persistence. Paste a mongodb+srv://... Atlas URI.
# While this is empty the backend runs a clearly-marked IN-MEMORY
# placeholder store seeded at startup (demo mode, no persistence).
#
# If this is set but the database is UNREACHABLE (bad URI, no network,
# IP not in the Atlas allowlist) the backend logs a loud warning and
# still starts on the in-memory store, so the website keeps working.
# Set REQUIRE_MONGO=true to make an unreachable database fatal instead
# (recommended when deploying, where silently losing writes is worse
# than not starting).
MONGODB_URI=
REQUIRE_MONGO=false

# --- Speech-to-Text (AssemblyAI) ------------------------------
# Paste an AssemblyAI API key to enable transcription.
# While empty, the voice endpoint accepts a `text` field instead of
# audio (marked DEMO fallback) and reports stt:false.
ASSEMBLYAI_API_KEY=

# --- Text-to-Speech (ElevenLabs) -------------------------------
# Paste an ElevenLabs API key to enable spoken replies.
# Voice/model overridable; defaults below.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Conversation brain (LLM, OpenAI-compatible) ---------------
# Paste an OpenAI API key for the real function-calling brain.
# While empty, the server runs a clearly-marked rule-based
# PLACEHOLDER brain over the SAME tool-use loop code path so the
# demo and tests exercise the real loop.
# Also usable with Ollama etc. via OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Product image understanding (vision) ----------------------
# Reuses the SAME OpenAI key/base URL as the brain above, with a
# vision-capable model. The photo is sent to the model as an inline
# image; the model sees the image only, never the product name or
# specs, so it cannot echo the catalog back as a "description".
# Without a key the visual tool reports it could not read the image —
# it never falls back to guessing from the product name.
VISION_MODEL=gpt-4o-mini
# Per-call timeout in ms, and the largest photo the fetcher will read.
VISION_TIMEOUT_MS=25000
VISION_IMAGE_MAX_BYTES=6000000

# --- Misc -------------------------------------------------------
# Currency symbol the LLM uses in spoken totals.
CURRENCY=
# Origin the agent loop uses to reach the tool gateway over HTTP.
SELF_ORIGIN=